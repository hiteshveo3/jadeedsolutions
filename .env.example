# Public site URL (used for SEO metadata, sitemap, canonical URLs)
# Production: https://www.jadeedsolutions.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact form email delivery (optional).
# If these are not set, submitted leads are logged to the server console
# instead of being emailed, so the form still works in development.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where lead notifications are sent, and the "from" address shown on emails.
CONTACT_TO_EMAIL=hello@jadeedsolutions.com
CONTACT_FROM_EMAIL=no-reply@jadeedsolutions.com
