# Public site URL (used for SEO metadata, sitemap, canonical URLs, audit-page links)
# Production: https://www.jadeedsolutions.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (leads, call confirmations and reminders, client portal notices).
# Same as Jadeed Marketing: Resend first (free tier, needed for scheduled reminders).
# Without Resend, the SMTP settings below are used; with neither, emails are logged
# to the server console so everything still works in development.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Where the team's emails go (comma-separated) and who emails come from.
LEAD_TO_EMAIL=info@jadeedsolutions.com
LEAD_FROM_EMAIL="Jadeed Solutions <hello@jadeedsolutions.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Older names, still read when the LEAD_ ones are empty.
CONTACT_TO_EMAIL=hello@jadeedsolutions.com
CONTACT_FROM_EMAIL=no-reply@jadeedsolutions.com

# Jadeed AI (site chat, lead summaries, dashboard and portal assistant).
# Use the same Gemini key as Jadeed Marketing. Without it, the chat quotes the
# best-matching page and the dashboard's AI buttons explain that AI isn't connected.
GEMINI_API_KEY=
# Optional: defaults to the model Jadeed Marketing uses.
GEMINI_MODEL=gemini-3.5-flash-lite
# Monthly AI budget in US dollars (alerts at 50%, 80% and 100%; at 100% the chat stops calling Gemini).
AI_MONTHLY_BUDGET_USD=10

# ---------------------------------------------------------------------------
# Team dashboard + client portal (Firebase, as on Jadeed Marketing).
# Local: `npm run emulators`, then `npm run seed:emulator`, then open /app.
# ---------------------------------------------------------------------------
# Where the dashboard lives (production: https://app.jadeedsolutions.com, routed by middleware.ts).
NEXT_PUBLIC_APP_URL=http://localhost:3000/app
# Firebase web app config (public identifiers, not secrets). Local emulators use the "demo-" project.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-jadeed-solutions.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-jadeed-solutions
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-jadeed-solutions.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local only: point at the emulators. Remove all four in production.
NEXT_PUBLIC_FIREBASE_EMULATORS=1
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9098
FIRESTORE_EMULATOR_HOST=127.0.0.1:8086
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9198
# Local only: stops a harmless "metadata lookup" warning when using the emulators.
METADATA_SERVER_DETECTION=none
GCLOUD_PROJECT=demo-jadeed-solutions
# Production only: the Firebase service-account JSON, base64-encoded.
FIREBASE_SERVICE_ACCOUNT=
# These emails become admins when they first sign in (comma-separated).
ADMIN_EMAILS=jadeedsolutionz@gmail.com
# Local only: the password the seed script gives its test users.
EMULATOR_TEST_PASSWORD=
# Vercel calls /api/cron/daily with this secret (monthly invoice drafts, chat summaries, reminders).
CRON_SECRET=

# Google Calendar + Meet for booked calls (OAuth client; add this site's
# /api/google/callback as an authorised redirect URI).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
