rules_version = '2';

// Jadeed Solutions dashboard and client portal — Firestore rules.
// Browsers get no direct access: every read and write goes through the Next.js server
// (Firebase Admin SDK, which bypasses these rules) after it has checked the signed-in
// person's role. Same set-up as Jadeed Marketing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
